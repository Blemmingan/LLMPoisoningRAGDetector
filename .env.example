# ==============================================================================
# Corpus Poisoning Forensic Analyst - Environment Configuration Template
# ==============================================================================

# Provider selection (defaults to deterministic local mocks)
CF_LLM_PROVIDER=mock
# Embedder: mock | local | litellm
#   local   = intfloat/multilingual-e5-small with sentence-transformers (free, offline after
#             the first ~470 MB download; Spanish and English in the same vector space)
#   litellm = text-embedding-3-small through the course proxy (paid)
# LLM: mock | litellm. Changing the embedder requires `kb ingest --reset` and `lit ingest --reset`.
CF_EMBEDDER_PROVIDER=local
# Model name or local path for the local embedder
# CF_LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Only used by the mock embedder
CF_EMBEDDING_DIMENSION=128

# Document Chunking Settings
CF_CHUNK_SIZE=500
CF_CHUNK_OVERLAP=100
CF_CHUNK_UNIT=char

# Retrieval Configuration
CF_TOP_K=3
# Search with the defensive normalization of each chunk (ablation flag)
CF_NORMALIZE_FOR_RETRIEVAL=true
# Literature passages added to the analyst prompt (0 disables the step, e.g. for ablation)
CF_LITERATURE_TOP_K=2

# Advanced retrieval of known attacks (no LLM): rewriting -> hybrid -> reranking
CF_QUERY_REWRITE=false
CF_QUERY_REWRITE_MAX_SENTENCES=3
CF_HYBRID_SEARCH=false
CF_RRF_K=60
CF_RERANK=false
# Cross-encoder name (downloaded on first use, ~470 MB) or a local path
CF_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
CF_RERANK_CANDIDATES=20

# Analyst prompt (name in analysis/prompts/ or path) and verifier penalty (ablation knobs)
CF_ANALYST_PROMPT=analyst_prompt
CF_VERIFIER_PENALIZE=true

# Document verdict: malicious when at least one finding passes this policy.
# Pick the threshold with the sweep in eval_summary.md (no new LLM calls needed).
CF_VERDICT_THRESHOLD=0.5
# Only count findings whose fragment was found verbatim in the document
CF_VERDICT_REQUIRE_VERIFIED=true
# Minimum severity that counts: baja | media | alta | critica
CF_VERDICT_MIN_SEVERITY=baja

# Directory Overrides (Optional - defaults to workspace layout)
# CF_DATA_DIR=data
# CF_VECTORSTORE_DIR=data/vectorstore
# CF_OUTPUT_DIR=reports

# ------------------------------------------------------------------------------
# LiteLLM proxy provided by the course (OpenAI-compatible API)
# Copy this file to .env and fill in the real values. NEVER commit .env.
# ------------------------------------------------------------------------------
# Base URL of the LiteLLM proxy (usually ends in /v1 or is the proxy root)
CF_LLM_BASE_URL=https://your-litellm-proxy-url
# Virtual key issued to the group for the proxy
CF_LLM_API_KEY=sk-your-litellm-key-here
# Chat model name exactly as exposed by the proxy (e.g. gpt-4o-mini)
CF_LLM_MODEL=your-chat-model-name
# Embedding model name exposed by the proxy, if any (e.g. text-embedding-3-small)
CF_EMBEDDING_MODEL=your-embedding-model-name
# To use the real LLM, set CF_LLM_PROVIDER=litellm (top of this file)

# Hugging Face read token, needed only for the gated HackAPrompt dataset.
# Create it at huggingface.co > Settings > Access Tokens (type: Read), from an account
# that accepted the dataset conditions.
CF_HF_TOKEN=hf_your-token-here

# Language of the free-text report fields (razonamiento, objetivo, mitigacion): es | en | pt
CF_REPORT_LANGUAGE=es

# Generation parameters
CF_LLM_TEMPERATURE=0.0
CF_LLM_MAX_OUTPUT_TOKENS=800

# ------------------------------------------------------------------------------
# Spending control. The team budget on the proxy is USD 10 in TOTAL (no refills),
# shared by the whole group. Each machine keeps a local ledger in data/usage/.
# Run `corpus-forensics usage` to see local and team spend.
# ------------------------------------------------------------------------------
CF_LLM_CACHE_ENABLED=true
CF_BUDGET_LIMIT_USD=8.0
