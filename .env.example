# ==============================================================================
# Corpus Poisoning Forensic Analyst - Environment Configuration Template
# ==============================================================================

# Provider selection (defaults to deterministic local mocks)
CF_LLM_PROVIDER=mock
CF_EMBEDDER_PROVIDER=mock
CF_EMBEDDING_DIMENSION=128

# Document Chunking Settings
CF_CHUNK_SIZE=500
CF_CHUNK_OVERLAP=100
CF_CHUNK_UNIT=char

# Retrieval Configuration
CF_TOP_K=3

# Directory Overrides (Optional - defaults to workspace layout)
# CF_DATA_DIR=data
# CF_VECTORSTORE_DIR=data/vectorstore
# CF_OUTPUT_DIR=reports

# ------------------------------------------------------------------------------
# LiteLLM proxy provided by the course (OpenAI-compatible API)
# Copy this file to .env and fill in the real values. NEVER commit .env.
# ------------------------------------------------------------------------------
# Base URL of the LiteLLM proxy (usually ends in /v1 or is the proxy root)
CF_LLM_BASE_URL=https://your-litellm-proxy-url
# Virtual key issued to the group for the proxy
CF_LLM_API_KEY=sk-your-litellm-key-here
# Chat model name exactly as exposed by the proxy (e.g. gpt-4o-mini)
CF_LLM_MODEL=your-chat-model-name
# Embedding model name exposed by the proxy, if any (e.g. text-embedding-3-small)
CF_EMBEDDING_MODEL=your-embedding-model-name
# To use the real LLM, set CF_LLM_PROVIDER=litellm (top of this file)

# Language of the free-text report fields (razonamiento, objetivo, mitigacion): es | en | pt
CF_REPORT_LANGUAGE=es

# Generation parameters
CF_LLM_TEMPERATURE=0.0
CF_LLM_MAX_OUTPUT_TOKENS=800

# ------------------------------------------------------------------------------
# Spending control. The team budget on the proxy is USD 10 in TOTAL (no refills),
# shared by the whole group. Each machine keeps a local ledger in data/usage/.
# Run `corpus-forensics usage` to see local and team spend.
# ------------------------------------------------------------------------------
CF_LLM_CACHE_ENABLED=true
CF_BUDGET_LIMIT_USD=8.0
